# Copies the backups off the machine (backup-copy.sh). Installed only by headquarters-install.sh
# with --backup-target; abarow-backup.service starts it after every successful
# backup (drop-in file: abarow-backup.container.d/copy.conf). It is not a Quadlet
# unit: it is installed as a systemd user unit
# (~/.config/systemd/user); the copying is done with the machine's rsync and ssh.
[Unit]
Description=abarow copies the headquarters backups off the machine

[Service]
Type=oneshot
# ABAROW_BACKUP_TARGET: the target (headquarters-install.sh writes it).
EnvironmentFile=%h/abarow/headquarters/backup-target.env
ExecStart=%h/abarow/headquarters/backup-copy.sh %h/abarow/headquarters/backups
TimeoutStartSec=3600
