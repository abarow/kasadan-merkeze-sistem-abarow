# The weekly maintenance of the headquarters database and its report (dbmaint.sh): bloated
# indexes are rebuilt without stopping the writes; the slowest statements, the largest
# tables and the WAL archive are printed (journalctl --user -u abarow-dbmaint). It fails
# if the WAL archive is failing. It is not a Quadlet unit: it is installed as a systemd
# user unit (~/.config/systemd/user).
[Unit]
Description=abarow headquarters weekly database maintenance
Wants=abarow-db.service
After=abarow-db.service abarow-basebackup.service

[Service]
Type=oneshot
ExecStart=%h/abarow/headquarters/dbmaint.sh abarow-db
TimeoutStartSec=6h
