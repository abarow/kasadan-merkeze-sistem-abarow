# The weekly physical backup (base backup) of the headquarters database and the cleaning of
# the WAL archive (basebackup.sh). With the archive the database can be restored to any
# moment since the oldest kept base backup (headquarters-install.sh restore-to). The next
# daily backup copies it off the machine with the dumps (--backup-target). It is not a
# Quadlet unit: it is installed as a systemd user unit (~/.config/systemd/user).
[Unit]
Description=abarow headquarters weekly base backup
Wants=abarow-db.service
After=abarow-db.service

[Service]
Type=oneshot
# The number of base backups kept; the archive goes back to the oldest one.
Environment=ABAROW_BASEBACKUP_KEEP=2
ExecStart=%h/abarow/headquarters/basebackup.sh abarow-db %h/abarow/headquarters/backups
TimeoutStartSec=6h
