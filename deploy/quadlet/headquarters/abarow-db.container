[Unit]
Description=abarow headquarters database (PostgreSQL)

[Container]
ContainerName=abarow-db
# The major version is fixed (18): minor versions (18.x) are taken once an update is approved;
# a major version upgrade needs a data migration and is done by hand.
Image=docker.io/library/postgres:18-alpine
Network=abarow-headquarters.network
Environment=POSTGRES_DB=abarow
Environment=POSTGRES_USER=abarow
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db-password
# The password is generated at random at install (headquarters-install.sh); the database is not
# opened to the outside, only the services on the headquarters network connect.
Secret=abarow-db-password,type=mount,target=/run/secrets/db-password
Volume=abarow-db-data:/var/lib/postgresql
HealthCmd=pg_isready -U abarow -d abarow
HealthInterval=5s
HealthTimeout=3s
HealthRetries=12
Notify=healthy
# The settings are computed from the number of stores (pkg/pgtune.ForHeadquarters; `reporting
# pgtune`). These are the base values for a single store; headquarters-install.sh rewrites them
# with a drop-in file (abarow-db.container.d/tune.conf) according to the real number
# of stores. If the settings change, services/headquarters/reporting/cmd/reporting/pgtune_test.go
# checks this file.
Exec=postgres -c shared_buffers=64MB -c max_connections=30 -c work_mem=4MB -c maintenance_work_mem=16MB -c wal_buffers=2MB -c effective_cache_size=88MB -c random_page_cost=1.1 -c min_wal_size=32MB -c max_wal_size=256MB -c checkpoint_completion_target=0.9 -c autovacuum_max_workers=2 -c max_worker_processes=4 -c max_parallel_workers=0 -c max_parallel_workers_per_gather=0 -c max_parallel_maintenance_workers=0 -c archive_mode=on -c archive_library=basic_archive -c basic_archive.archive_directory=/var/lib/postgresql -c archive_timeout=15min
PodmanArgs=--memory=256m

[Service]
Restart=always
TimeoutStartSec=300
# At shutdown PostgreSQL is given time to flush what it wrote to disk.
TimeoutStopSec=120

[Quadlet]
# Headquarters does not wait for the external network: the services connect to each other inside the machine,
# the stores renew the connection themselves. On a machine where network-online.target
# never comes the boot would take minutes.
DefaultDependencies=false

[Install]
WantedBy=default.target
