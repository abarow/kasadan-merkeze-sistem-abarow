{
  "distSpecVersion": "1.1.1",
  "storage": { "rootDirectory": "/var/lib/registry" },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "tls": { "cert": "/run/secrets/tls/server.pem", "key": "/run/secrets/tls/server.key" },
    "auth": {
      "bearer": {
        "realm": "https://@ADDRESS@:5444/token",
        "service": "abarow-zot",
        "cert": "/etc/mirror/mirror.crt"
      }
    }
  },
  "extensions": {
    "sync": {
      "enable": true,
      "credentialsFile": "/etc/zot/identity.json",
      "registries": [
        {
          "urls": ["https://@UPSTREAM@"],
          "onDemand": true,
          "tlsVerify": true,
          "certDir": "/etc/zot/ca",
          "content": [{ "prefix": "**" }]
        }
      ]
    }
  },
  "log": { "level": "info" }
}
