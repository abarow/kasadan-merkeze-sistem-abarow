[Unit]
Description=abarow image mirror (store server: a cache of the images coming from the upper tier)
Wants=abarow-store-mirror-auth.service
After=abarow-store-mirror-auth.service

[Container]
ContainerName=abarow-store-mirror
# Zot is an OCI-compatible registry. Authentication is with the tokens of the authorization service
# (bearer); the install script writes its configuration as %h/abarow/mirror/zot.json.
Image=ghcr.io/project-zot/zot-linux-amd64:v2.1.23
Network=abarow-store.network
Exec=serve /etc/zot/zot.json
# The directory is shared with the agent: the agent renews identity.json with the upper tier's token and
# makes Zot reload the configuration (Zot reads the identity file only when the configuration changes).
Volume=%h/abarow/mirror:/etc/zot:Z
# The token verification certificate (mirror.crt): the authorization service's data volume, read-only.
Volume=abarow-store-mirror-auth:/etc/mirror:ro
Volume=abarow-store-mirror-data:/var/lib/registry
Secret=abarow-store-tls-cert,type=mount,target=/run/secrets/tls/server.pem,mode=0444
Secret=abarow-store-tls-key,type=mount,target=/run/secrets/tls/server.key,mode=0400
PublishPort=5443:5000
PodmanArgs=--memory=256m

[Service]
Restart=always
TimeoutStartSec=120

[Quadlet]
# The install script writes the network setting.

[Install]
WantedBy=default.target
