# The daily backup of the store server database (abarow-store-backup.service). If the machine is off
# at that time it is taken when it comes on. It is not a Quadlet unit: it is installed
# as a systemd user unit (~/.config/systemd/user).
[Unit]
Description=abarow store server daily database backup

[Timer]
OnCalendar=*-*-* 03:45:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
